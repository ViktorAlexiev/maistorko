# Copy to supabase/.env (gitignored) and put a long random string here.
# It replaces the Supabase CLI's well-known default JWT secret, so the local stack is safe to expose
# through the demo tunnel. After changing it, restart (npm run db:stop && npm run db:start) and copy the
# new ANON_KEY / SERVICE_ROLE_KEY from `npx supabase status -o env` into web/.env.local.
SUPABASE_AUTH_JWT_SECRET=

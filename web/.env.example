# Copy to .env.local and fill in.
#
# Local Supabase (Docker): run `npx supabase status -o env` in the repo root
# and copy API_URL / ANON_KEY / SERVICE_ROLE_KEY from there.
# Hosted Supabase: Project Settings -> API.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public site URL, used for auth redirects (password reset) and SEO metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ONLY for the local seed / RLS test scripts (npm run seed, npm run test:rls).
# Never expose it to the browser, never prefix it with NEXT_PUBLIC_, never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Background worker (npm run worker): e-mails and nightly cleanup. Optional locally.
# SITE_URL is used for links inside e-mails; SMTP_URL points at Mailpit locally (supabase/config.toml exposes 54325).
SITE_URL=http://localhost:3000
SMTP_URL=smtp://127.0.0.1:54325
MAIL_FROM="Майсторлъка <no-reply@maistorko.test>"

# Optional bot check (Cloudflare Turnstile) on sign-up, sign-in and password reset.
# With both keys set the widget appears and the server verifies it; without them nothing changes.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# DEMO ONLY: shows an "Активирай Pro" button to every craftsman. Leave unset in a real launch.
# DEMO_PRO_BUTTON=1
